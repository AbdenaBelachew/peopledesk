# ─── PeopleDesk environment template — copy to .env and adjust ───
# NEVER commit real credentials.

# Database (docker-compose default)
POSTGRES_USER=peopledesk
POSTGRES_PASSWORD=peopledesk_dev_password
POSTGRES_DB=peopledesk

# Backend
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__PostgreSQL=Host=postgres;Port=5432;Database=peopledesk;Username=peopledesk;Password=peopledesk_dev_password

# JWT — REQUIRED. Generate: openssl rand -base64 48
JWT__SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET_VALUE
JWT__Issuer=peopledesk
JWT__Audience=peopledesk-web

# Auth
Auth__FrontendBaseUrl=http://localhost:5173
Auth__AccessTokenMinutes=15
Auth__RefreshTokenDays=7

# Platform super admin (created at first startup if missing)
Platform__SuperAdminEmail=superadmin@peopledesk.local
Platform__SuperAdminPassword=ChangeMe_Platform#2026

# Demo data — DEVELOPMENT ONLY
SEED_DEMO_DATA=false

# Email: FileSink (dev, writes .eml files) or Smtp
Email__Mode=FileSink
Email__SinkPath=logs/dev-emails
# Email__Mode=Smtp
# Email__Host=smtp.example.com
# Email__Port=587
# Email__UseSsl=true
# Email__Username=
# Email__Password=
# Email__FromAddress=no-reply@example.com

# File storage
Storage__Root=data/files
